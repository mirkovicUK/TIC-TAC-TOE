APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# 30 days in minutes; a Player_Session must outlive the 7-day game retention window
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Player_Session cookie attributes (Req 10.11). The two below match the framework
# defaults and are stated anyway, so a deployment can see the intended values without
# reading config/session.php. Lax is deliberate: every state change is a same-site POST,
# and the only cross-site entry point is a Join_Link, which is a top-level GET — Strict
# would drop the session on exactly that navigation. See config/session.php.
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# false here because local development is served over plain HTTP, where a Secure cookie
# is never sent back. The hosted stack terminates TLS at Caddy and sets this to true in
# its own environment (task 13.2, from the scheme obtained in task 2.2).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# `file`, NOT `database`, and this is load-bearing rather than a preference. The rate
# limiters (Req 10.6-10.8) increment a counter on every request, and Laravel's database
# cache store does that as a SELECT-then-UPDATE inside one transaction
# (`Illuminate\Cache\DatabaseStore::incrementOrDecrement`), with `lockForUpdate()` a
# no-op on SQLite. Two players polling every 2 seconds (ADR-001) then collide: one reads
# the counter, the other commits first, and the first's UPDATE hits a stale snapshot.
# SQLite returns SQLITE_BUSY for that case IMMEDIATELY — `busy_timeout` does not apply,
# because waiting cannot help a transaction that must roll back and retry — Laravel does
# not retry, and the player gets a 500 mid-game. Reproduced at 13 failures in 30
# concurrent requests before this changed; zero at 30 and at 60 after.
#
# The cost of `file` is that its increment is an unlocked read-then-write, so heavy
# concurrency can lose one, leaving the limiter marginally permissive. That is the right
# failure to choose: one extra request through, rather than an error page for someone
# whose turn it was. `array` is not an option — it is per-request, so nothing accumulates
# and rate limiting stops existing.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
