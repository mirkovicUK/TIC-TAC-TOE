*.log
.DS_Store

# Employer-supplied material: the job description and the coding-challenge brief.
# Deliberately not published. The job description carries a named employee's work
# email address and a salary figure, and this repository is public (Req 12.4).
# The brief is The Skills Network's material, not the candidate's, and publishing
# it would expose the exact challenge to future applicants.
/the-skills-network

.env
.env.backup
.env.production
# Specific to one provisioned instance: its hostname, its resource ids, and the APP_KEY
# its stack runs with. `deploy/app.env.example` is the tracked template for the last of
# them, and `compose.yaml` reads `deploy/app.env` through `env_file:`.
/deploy/Caddyfile.local
/deploy/.provisioned.env
/deploy/app.env
.phpactor.json
.phpunit.result.cache
# Written by `BrowserExpectationFailedException::from()` on any failed browser
# assertion, and wiped by `Screenshot::cleanup()` at the start of the next browser
# run — so between a red run and the next green one it would otherwise show as
# untracked and could be committed by a careless `git add`.
/tests/Browser/Screenshots
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
