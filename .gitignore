*.log
.DS_Store

# Employer-supplied material, deliberately not published: this repository is
# public (Req 12.4) and none of it is the author's to license.
/the-skills-network

.env
.env.backup
.env.production
# Specific to one provisioned instance: its hostname, its resource ids, and the APP_KEY
# its stack runs with. `deploy/app.env.example` is the tracked template for the last of
# them, and `compose.yaml` reads `deploy/app.env` through `env_file:`.
/deploy/Caddyfile.local
/deploy/.provisioned.env
/deploy/app.env
# Which Release_Tag that instance is running, and the tag it would fall back to. State,
# not configuration: the deploy document rewrites it on every deployment, and it is the
# only place the previous tag is authoritatively known.
/deploy/release.env
/deploy/release.env.*
/deploy/.deploy.lock
.phpactor.json
.phpunit.result.cache
# Written by `BrowserExpectationFailedException::from()` on any failed browser
# assertion, and wiped by `Screenshot::cleanup()` at the start of the next browser
# run — so between a red run and the next green one it would otherwise show as
# untracked and could be committed by a careless `git add`.
/tests/Browser/Screenshots
/.codex
/.cursor/
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
/public/build
/public/fonts-manifest.dev.json
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
_ide_helper.php
Homestead.json
Homestead.yaml
Thumbs.db
